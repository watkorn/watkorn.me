{
  "name": "watkorn.me",
  "version": "1.1.0",
  "private": true,
  "description": "Personal site of watkorn: CTF writeups, security tools, and a terminal with a flag in it. Static React + Markdown, deployed to GitHub Pages.",
  "homepage": "https://watkorn.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/watkorn/watkorn.me.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "node scripts/start.mjs",
    "content": "node scripts/content.mjs",
    "new-post": "node scripts/new-post.mjs",
    "build": "node scripts/content.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir build-ssr && node scripts/prerender.mjs && node scripts/csp.mjs",
    "preview": "vite preview --outDir build --port 4173",
    "test": "playwright test",
    "deploy": "gh-pages -d build --nojekyll"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^6.1.1",
    "gh-pages": "^6.3.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "marked-highlight": "^2.2.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  },
  "type": "module"
}
