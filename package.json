{
  "name": "watkorn.me",
  "version": "1.0.0",
  "private": true,
  "description": "Personal site of watkorn: CTF writeups, security tools, and a terminal with a flag in it. Static React + Markdown, deployed to GitHub Pages.",
  "homepage": "https://watkorn.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/watkorn/watkorn.me.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "node scripts/start.mjs",
    "content": "node scripts/content.mjs",
    "new-post": "node scripts/new-post.mjs",
    "build": "node scripts/content.mjs && react-scripts build && node scripts/csp.mjs",
    "test": "node scripts/content.mjs && react-scripts test",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build --nojekyll"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^2.0.5",
    "react-infinite-scroll-component": "^6.1.0",
    "react-router-dom": "^6.16.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^6.1.1",
    "gh-pages": "^6.3.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "marked-highlight": "^2.2.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
